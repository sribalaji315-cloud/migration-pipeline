# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real credentials.
# start.ps1 loads these into the API process. Shell variables that are already set win over .env.
# Nested settings use a double underscore: Swing__Library = "Swing": { "Library": ... }.

# --- Swing (IBM i ODBC, read-only) ---------------------------------------------------------------
# Swing__Enabled=true
# Swing__OdbcConnectionString=DSN=swing;UID=your_swing_user;PWD=your_password
# Swing__Library=SWAPDAT
# Swing__AllowedLibraries__0=SWAPDAT

# --- Migration Tool (leave UseFixtures=true to keep using the test files) -----------------------
# MigrationTool__UseFixtures=false
# MigrationTool__BaseUrl=https://hwds-dev.svartalfheim.io
# Recommended: user + password (POST /auth/login; the app logs in again by itself when the token expires).
# When User and Password are set they win over a bearer token.
# MigrationTool__User=
# MigrationTool__Password=
# ... or a static bearer token (copied e.g. from Postman; expires about hourly - replace and restart):
# MigrationTool__BearerToken=eyJ...
# Set to false if GET /export/workspace-mappings is not available (one call per BOM item instead):
# MigrationTool__UseBulkEndpoint=false
