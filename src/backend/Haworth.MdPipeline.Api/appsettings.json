{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "DefaultConnection": "Data Source=md_pipeline.db" },
  "Jwt": {
    "Issuer": "Haworth.MdPipeline",
    "Audience": "Haworth.MdPipeline",
    "SigningKey": "development-only-md-pipeline-signing-key-change-me"
  },
  "MigrationTool": {
    "BaseUrl": "http://localhost:8000",
    "User": "",
    "Password": "",
    "MaxConcurrency": 5,
    "UseBulkEndpoint": true,
    "UseFixtures": false,
    "BulkPageSize": 5000,
    "ItemsBatchSize": 500
  },
  "Swing": {
    "Enabled": true,
    "OdbcConnectionString": "DSN=SWING;UID=md_pipeline_ro;PWD=",
    "Library": "CONFIGURE_LIBRARY",
    "AllowedLibraries": [],
    "CommandTimeoutSeconds": 1800,
    "TypeCodes": { "0": "FIXED", "2": "CONFIGURABLE" },
    "PseudoFlags": { "J": true, "Y": true, "N": false },
    "OpenEndedDateIn": [ "0/0/0" ],
    "OpenEndedDateOut": [ "0/0/0" ],
    "TwoDigitYearPivot": 79,
    "DateOutInclusive": true
  },
  "Pipeline": {
    "DataDir": "data",
    "FixturesDir": "../tests/fixtures",
    "DuckDbMemoryLimit": "8GB",
    "DuckDbThreads": 8,
    "MappingBuckets": 64,
    "MaxBomDepth": 100
  },
  "AutoMigrate": false,
  "SeedIdentity": false,
  "AllowedOrigins": [ "http://localhost:3100" ]
}
